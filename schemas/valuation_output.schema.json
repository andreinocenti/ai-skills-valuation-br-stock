{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "valuation-br-stock output",
  "type": "object",
  "required": [
    "ticker",
    "company_name",
    "current_price",
    "fair_value_base",
    "fair_value_conservative",
    "fair_value_optimistic",
    "suggested_ceiling_price",
    "base_ceiling_price",
    "risk_adjusted_ceiling_price",
    "projected_ceiling_price",
    "projected_ceiling_prices",
    "margin_of_safety",
    "dividend_safe_yield",
    "projected_yield_on_cost_year_5",
    "quality_score",
    "opportunity_score",
    "risk_level",
    "verdict",
    "confidence",
    "calculation_metadata",
    "valuation"
  ],
  "properties": {
    "ticker": { "type": "string" },
    "company_name": { "type": "string" },
    "current_price": { "type": "number" },
    "fair_value_base": { "type": "number" },
    "fair_value_conservative": { "type": "number" },
    "fair_value_optimistic": { "type": "number" },
    "suggested_ceiling_price": { "type": "number" },
    "base_ceiling_price": { "type": "number" },
    "risk_adjusted_ceiling_price": { "type": "number" },
    "projected_ceiling_price": { "type": "number" },
    "projected_ceiling_prices": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true }
    },
    "margin_of_safety": { "type": "number" },
    "dividend_safe_yield": { "type": "number" },
    "projected_yield_on_cost_year_5": { "type": "number" },
    "quality_score": { "type": "number" },
    "opportunity_score": { "type": "number" },
    "risk_level": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "verdict": {
      "type": "string",
      "enum": [
        "Evitar",
        "Cara",
        "Justa",
        "Interessante",
        "Atrativa com margem de seguranca"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium_high", "medium", "medium_low", "low"]
    },
    "calculation_metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "valuation": {
      "type": "object",
      "required": [
        "graham",
        "bazin",
        "peter_lynch",
        "ddm",
        "dcf_fcfe",
        "dcf_fcff",
        "multiples",
        "normalized_ev_ebitda",
        "reverse_dcf",
        "residual_income",
        "sotp",
        "nav"
      ],
      "additionalProperties": true
    },
    "financial_diagnosis": {
      "type": "object",
      "additionalProperties": true
    },
    "data_quality": {
      "type": "object",
      "additionalProperties": true
    },
    "sources": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true }
    },
    "risks": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true }
    },
    "scores": {
      "type": "object",
      "additionalProperties": true
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": true
}
