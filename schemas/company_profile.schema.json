{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Company profile",
  "type": "object",
  "required": ["ticker", "name", "market", "currency"],
  "properties": {
    "ticker": { "type": "string" },
    "name": { "type": "string" },
    "market": { "type": "string", "const": "B3" },
    "cnpj": { "type": "string" },
    "cvm_code": { "type": "string" },
    "sector": { "type": "string" },
    "subsector": { "type": "string" },
    "segment": { "type": "string" },
    "share_class": { "type": "string" },
    "shares_outstanding": { "type": "number" },
    "free_float": { "type": "number" },
    "ri_url": { "type": "string" },
    "currency": { "type": "string", "default": "BRL" },
    "source_status": {
      "type": "string",
      "enum": ["oficial", "auxiliar", "estimado", "inferido", "nao_encontrado"]
    }
  },
  "additionalProperties": true
}
